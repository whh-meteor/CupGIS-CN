{
  "name": "cupgis-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .local/wrangler",
    "preview": "npm run build && wrangler dev",
    "test": "node --test",
    "previews": "node scripts/capture-previews.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.151.0"
  }
}
